---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, path, abs } from '../../lib/site';
const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="All articles" description={`Every article on ${site.name}, newest first.`} canonicalPath="blog"
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Articles', url: abs('blog') }]}>
  <h1>All articles</h1>
  <ul class="post-list">
    {posts.map((p) => (
      <li><h2><a href={path(`blog/${p.id}`)}>{p.data.title}</a></h2>
        <p class="meta">{p.data.date.toISOString().slice(0, 10)} · {p.data.category}</p>
        <p>{p.data.description}</p></li>
    ))}
  </ul>
</Base>
