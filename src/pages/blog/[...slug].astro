---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, abs, path, readingTime } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const url = `blog/${post.id}`;
const toc = headings.filter((h) => h.depth === 2);
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: p.data.tags.filter((t) => d.tags.includes(t)).length + (p.data.category === d.category ? 1 : 0) }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || +b.p.data.date - +a.p.data.date)
  .slice(0, 3)
  .map((x) => x.p);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    mainEntityOfPage: abs(url),
    inLanguage: site.language,
    wordCount: (post.body ?? '').split(/\s+/).length,
    keywords: d.tags.join(', '),
    articleSection: d.category,
    author: { '@type': 'Organization', name: site.author.name, url: abs('about') },
    publisher: { '@type': 'Organization', name: site.name, url: abs() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs() },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: abs('blog') },
      { '@type': 'ListItem', position: 3, name: d.title, item: abs(url) },
    ],
  },
];
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.description} canonicalPath={url} type="article" published={d.date} modified={d.updated ?? d.date} jsonLd={jsonLd}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={path()}>Home</a> / <a href={path('blog')}>Articles</a></nav>
  <article>
    <h1>{d.title}</h1>
    <p class="meta">
      By <a href={path('about')}>{site.author.name}</a> ·
      Published <time datetime={d.date.toISOString()}>{fmt(d.date)}</time>
      {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>}
      · {readingTime(post.body ?? '')} min read
    </p>
    {toc.length > 2 && (
      <nav class="toc" aria-label="Table of contents">
        <p><strong>In this article</strong></p>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
    <Content />
    {d.faq.length > 0 && (
      <section>
        <h2 id="faq">Frequently asked questions</h2>
        {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}
    {d.sources.length > 0 && (
      <section class="sources">
        <h2 id="sources">Sources</h2>
        <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener nofollow">{s.title}</a></li>)}</ul>
      </section>
    )}
    <aside class="author-box">
      <p><strong>{site.author.name}</strong> — {site.author.bio}</p>
      <p class="meta">{site.aiDisclosure}</p>
    </aside>
  </article>
  {related.length > 0 && (
    <section class="related">
      <h2>Keep reading</h2>
      <ul>{related.map((r) => <li><a href={path(`blog/${r.id}`)}>{r.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
