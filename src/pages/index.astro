---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, path, abs } from '../lib/site';
const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
const cats = [...new Set(posts.map((p) => p.data.category))];
---
<Base title={`${site.name} — ${site.tagline}`} description={site.tagline + ` Guides on ${site.niche}.`} canonicalPath=""
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'Blog', name: site.name, url: abs(), description: site.tagline }]}>
  <h1>{site.name}</h1>
  <p>{site.tagline}</p>
  {cats.length > 0 && <p>{cats.map((c) => <span class="tag">{c}</span>)}</p>}
  <h2>Latest articles</h2>
  <ul class="post-list">
    {posts.slice(0, 15).map((p) => (
      <li><h2><a href={path(`blog/${p.id}`)}>{p.data.title}</a></h2>
        <p class="meta">{p.data.date.toISOString().slice(0, 10)} · {p.data.category}</p>
        <p>{p.data.description}</p></li>
    ))}
  </ul>
  <p><a href={path('blog')}>See all articles →</a></p>
</Base>
