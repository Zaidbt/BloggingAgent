---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { site, path, abs } from '../lib/site';

const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
const [lead, ...rest] = posts;
const side = rest.slice(0, 3);
const grid = rest.slice(3, 15);
---
<Base title={`${site.name} — ${site.tagline}`} description={site.tagline} canonicalPath=""
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'Blog', name: site.name, url: abs(), inLanguage: 'ar' }]}>
  <div class="wrap">
    {!lead && <p class="empty">لا توجد مقالات بعد. سيظهر أول خبر هنا فور تشغيل الوكيل.</p>}
    {lead && (
      <section class={side.length ? "lead-grid" : "lead-grid solo"}>
        <PostCard post={lead} variant="hero" eager />
        {side.length > 0 && (
          <aside class="side" aria-label="أخبار أخرى">
            <h2 class="section-title">أيضاً في الأخبار</h2>
            {side.map((p) => <PostCard post={p} variant="row" />)}
          </aside>
        )}
      </section>
    )}
    {grid.length > 0 && (
      <section>
        <h2 class="section-title">آخر المقالات</h2>
        <div class="grid">{grid.map((p) => <PostCard post={p} />)}</div>
        <p class="more"><a class="btn" href={path('blog')}>عرض كل المقالات</a></p>
      </section>
    )}
  </div>
</Base>
