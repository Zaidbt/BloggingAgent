---
import { getCollection } from 'astro:content';
import { site, abs, path, fmtDate, catPath, R } from '../lib/site';
import { fontFiles } from '../lib/fonts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  image?: string;
  imageAlt?: string;
  section?: string;
  tags?: string[];
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, canonicalPath, type = 'website', published, modified, image, imageAlt, section, tags = [], jsonLd = [], noindex = false } = Astro.props;
const canonical = abs(canonicalPath);
// Google shows ~60 characters: long headlines go out alone, short ones carry the brand
const fullTitle = title.includes(site.name) || title.length > 48 ? title : `${title} | ${site.name}`;
const posts = await getCollection('posts');
const usedCats = site.categories.filter((c) => posts.some((p) => p.data.category === c.slug));
const graph = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': abs() + '#website', name: site.name, url: abs(), inLanguage: 'ar-MA', description: site.tagline, publisher: { '@id': abs() + '#org' } },
  { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', '@id': abs() + '#org', name: site.name, url: abs(), logo: { '@type': 'ImageObject', url: abs('icon-512.png'), width: 512, height: 512 }, description: site.tagline, areaServed: { '@type': 'Country', name: 'المغرب' }, publishingPrinciples: abs(R.editorial), ethicsPolicy: abs(R.editorial), correctionsPolicy: abs(R.editorial), contactPoint: { '@type': 'ContactPoint', contactType: 'editorial', email: site.contactEmail, availableLanguage: ['ar'] } },
  ...jsonLd,
];
const ogImage = new URL(image ?? path('og-default.jpg'), site.url).href;
const fontCss = fontFiles
  .map((f) => `@font-face{font-family:'${f.family}';font-style:normal;font-weight:${f.weight};font-display:swap;src:url(${path('fonts/' + f.file)}) format('woff2');unicode-range:${f.range}}`)
  .join('');
const preload = fontFiles.filter((f) => f.subset === 'arabic' && (f.family === 'Cairo' || f.weight === '400'));
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <meta name="googlebot-news" content={noindex ? 'noindex' : 'index,follow'} />
    <meta name="author" content={site.author.name} />
    <meta name="theme-color" content="#c1272d" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={path('apple-touch-icon.png')} />
    <link rel="manifest" href={path('manifest.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={path('sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={path('rss.xml')} />
    {preload.map((f) => <link rel="preload" as="font" type="font/woff2" href={path('fonts/' + f.file)} crossorigin />)}
    <style is:inline set:html={fontCss}></style>
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ar_MA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    {type === 'article' && <meta property="article:author" content={abs(R.about)} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">تخطَّ إلى المحتوى</a>
    <div class="topbar"><div class="wrap"><span>{fmtDate(new Date())}</span><span class="topbar-note">أخبار المغرب أولاً بأول</span></div></div>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={path()} aria-label={site.name}>
          <svg viewBox="0 0 64 64" width="38" height="38" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#c1272d"/><path d="M32 8l6.500 14.600L53 18l-4.600 14.500L56 32l-7.600 3.500L53 50l-14.500-4.600L32 56l-6.500-10.600L11 50l4.600-14.500L8 32l7.600-.500L11 18l14.500 4.600z" fill="#fff"/><circle cx="32" cy="32" r="7" fill="#006233"/></svg>
          <span>{site.name}</span>
        </a>
        <nav class="cats" aria-label="الأقسام">
          <a href={path()}>الرئيسية</a>
          {usedCats.map((c) => <a href={path(catPath(c.slug))}>{c.label}</a>)}
          <a href={path(R.news)}>الأرشيف</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">{site.name}</p>
          <p>{site.tagline}</p>
        </div>
        <div>
          <p class="footer-title">الأقسام</p>
          <ul>{usedCats.map((c) => <li><a href={path(catPath(c.slug))}>{c.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer-title">عن الموقع</p>
          <ul>
            <li><a href={path(R.about)}>من نحن</a></li>
            <li><a href={path(R.editorial)}>سياسة التحرير والتصحيحات</a></li>
            <li><a href={path(R.contact)}>اتصل بنا</a></li>
            <li><a href={path(R.privacy)}>سياسة الخصوصية</a></li>
            <li><a href={path('rss.xml')}>RSS</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">© {new Date().getFullYear()} {site.name}. محتوى مُعدّ بمساعدة الذكاء الاصطناعي ومنسوب إلى مصادره.</div>
    </footer>
  </body>
</html>
