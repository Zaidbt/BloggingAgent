{
  "name": "bloggingagent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "agent": "node agent/run.mjs",
    "agent:dry": "node agent/run.mjs --dry-run",
    "news": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA agent/prepare.mjs",
    "post": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA agent/add-post.mjs",
    "contact": "node agent/contact.mjs",
    "social": "node agent/social.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  }
}
